# PostgreSQL connection string (Coolify → your PostgreSQL resource → "Postgres URL (internal)")
DATABASE_URL=postgres://postgres:password@your-postgres-host:5432/postgres

# Admin login security — set this to any long random text
SESSION_SECRET=

# Only used the very first time, when the database has no admin account yet
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Official Meta WhatsApp Cloud API (server-side only)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ADMIN_PHONE=923012730116
WHATSAPP_TEMPLATE_NAME=order_confirmation
WHATSAPP_TEMPLATE_LANGUAGE=en_US

# Facebook / Meta website integration
NEXT_PUBLIC_FACEBOOK_PIXEL_ID=
FACEBOOK_DOMAIN_VERIFICATION=
